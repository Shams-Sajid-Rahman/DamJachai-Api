# Server
NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/damjachai

# JWT secrets - use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# SameSite for the refresh cookie: lax (same site), strict, or none (different sites, needs HTTPS)
COOKIE_SAMESITE=lax

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# First admin account, created by `npm run seed` (never hard-coded)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
